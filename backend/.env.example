# Copy to .env and fill in. Never commit real values.

PORT=4000
# Comma-separated list of origins allowed to call this API (your Next.js dev/prod URLs)
CORS_ORIGINS=http://localhost:3000

# ---- Supabase — SERVER ONLY ----------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Databricks — SERVER ONLY ---------------------------------------
DATABRICKS_SERVER_HOSTNAME=
# SQL Warehouse HTTP path, needed for Delta analytics only (not Genie).
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=c_qube_catalog
DATABRICKS_SCHEMA=campus
# Genie space ID only — no "?o=" workspace query suffix.
DATABRICKS_GENIE_SPACE_ID=

# Auth — set ONE of these two pairs, not both:
#
# Preferred: OAuth service-principal (works even when your workspace
# admin has personal access tokens disabled — the common case). See
# backend/README.md "Databricks auth" for how to create these.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
#
# Legacy fallback: a personal access token, only if your workspace
# still allows generating one (Settings -> Developer -> Access tokens).
DATABRICKS_ACCESS_TOKEN=

# Email domain every account (student/club/admin) must belong to.
ALLOWED_EMAIL_DOMAIN=bmsce.ac.in
